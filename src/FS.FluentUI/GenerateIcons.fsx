open System
open System.IO
open System.Text.RegularExpressions

let iconsDirectory =
    "../../src/FS.FluentUI.TestGrounds/node_modules/@fluentui/react-icons/lib/icons"

let iconOutputFile = "./GeneratedIcons.fs"
let bundleIconOutputFile = "./GeneratedBundleIcons.fs"

let iconPattern =
    Regex(
        @"\b[A-Z][A-Za-z0-9]*(?:Filled|Regular|Color)\b",
        RegexOptions.Compiled
    )

let bundleIconPattern =
    Regex(
        @"\b[A-Z][A-Za-z0-9]*(?:Filled|Regular)\b",
        RegexOptions.Compiled
    )

let lowerFirst (name: string) =
    if String.IsNullOrEmpty name then
        name
    else
        name.Substring(0, 1).ToLowerInvariant() + name.Substring(1)

let iconNames =
    Directory.GetFiles(
        iconsDirectory,
        "chunk*.d.ts",
        SearchOption.TopDirectoryOnly
    )
    |> Array.collect (fun file ->
        File.ReadAllLines file
        |> Array.filter (fun line ->
            line.TrimStart().StartsWith("export ")
        )
        |> Array.collect (fun line ->
            iconPattern.Matches(line)
            |> Seq.cast<Match>
            |> Seq.map (fun m -> m.Value)
            |> Seq.toArray
        )
    )
    |> Array.distinct
    |> Array.sort


let bundleIconNames =
    Directory.GetFiles(
        iconsDirectory,
        "chunk*.d.ts",
        SearchOption.TopDirectoryOnly
    )
    |> Array.collect (fun file ->
        File.ReadAllLines file
        |> Array.filter (fun line ->
            line.TrimStart().StartsWith("export ")
        )
        |> Array.collect (fun line ->
            bundleIconPattern.Matches(line)
            |> Seq.cast<Match>
            |> Seq.map (fun m -> m.Value)
            |> Seq.toArray
        )
    )
    |> Array.distinct
    |> Array.groupBy (fun name ->
        Regex.Replace(name, "(Filled|Regular)$", "")
    )
    |> Array.filter (fun (baseName, variants) ->
        let hasFilled = variants |> Array.contains (baseName + "Filled")
        let hasRegular = variants |> Array.contains (baseName + "Regular")

        hasFilled && hasRegular
    )
    |> Array.collect snd
    |> Array.filter (fun name ->
        name.EndsWith("Filled") || name.EndsWith("Regular")
    )
    |> Array.map (fun i -> (i.Replace ("Filled", "")).Replace ("Regular", ""))
    |> Array.distinct
    |> Array.sort

let generateIcon (name: string) =
    $"        static member inline {lowerFirst name} (props: IIconProp list) = createElement (import \"{name}\" FluentIcons) props"

let generateBundleIcon (name: string) =
    $"    static member inline {lowerFirst name} = bundleHelper.expandImport \"{name}\""

let iconOutput =
    [
        "// <auto-generated>"
        "// Generated by GenerateIcons.fsx"
        "// Meant to be copied and pasted into FluentUI.fs"
        "// </auto-generated>"
        ""
        yield! iconNames |> Array.map generateIcon
    ]
    |> String.concat Environment.NewLine

File.WriteAllText(iconOutputFile, iconOutput) |> ignore

printfn "Generated %d icons in %s" iconNames.Length iconOutputFile

//!! Run 'dotnet fsi GenerateIcons.fsx' to auto-generate icon bindings

let bundleIconOutput =
    [
        "// <auto-generated>"
        "// Generated by GenerateBundleIcons.fsx"
        "// Meant to be copied and pasted into BundleIcons.fs"
        "// </auto-generated>"
        ""
        yield! bundleIconNames |> Array.map generateBundleIcon
    ]
    |> String.concat Environment.NewLine

File.WriteAllText(bundleIconOutputFile, bundleIconOutput)

printfn "Generated %d icons in %s" bundleIconNames.Length bundleIconOutputFile

//!! Run 'dotnet fsi GenerateIcons.fsx' to auto-generate icon bindings

